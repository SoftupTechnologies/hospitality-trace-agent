    {
      "parameters": {
        "jsCode": "// n8n Code node (JavaScript)\n// Purpose: Extract booking + (optional) reservation details\n// resCtx is the ONLY reservation source. No fallbacks.\n\n// --------------------\n// Read upstream sources\n// --------------------\nconst booking = $('Get booking details').first().json;\n\nconst context = 'booking';\nconst now = new Date().toISOString();\n\n// --------------------\n// Booker & Guest\n// --------------------\nconst booker = booking?.booker || {};\n\n// --------------------\n// Identifiers\n// --------------------\nconst bookingId = booking?.id || null;\n\n// --------------------\n// Booker fields\n// --------------------\nconst bookerFirstName = booker?.firstName || null;\nconst bookerLastName  = booker?.lastName || null;\n\nconst primaryGuestFirstName = null;\nconst primaryGuestLastName  = null;\nconst primaryGuestBirthday  = null;\n\n// --------------------\n// Comments\n// --------------------\nconst bookerComment =\n  typeof booking?.bookerComment === 'string'\n    ? booking.bookerComment\n    : null;\n\n// TODO: Temp disable\nconst extraBookingComment = null;\n  // typeof booking?.comment === 'string'\n  //   ? booking.comment\n  //   : null;\n\nconst reservationComment = null;\nconst guestComment = null\n\n// --------------------\n// Unit / Unit Group / Property\n// --------------------\nconst unit = {};\nconst unitGroup = {};\nconst property = booking?.propertyValues?.[0]?.property\n  || {};\n\n// --------------------\n// Reservation details\n// --------------------\nconst arrival = null;\nconst departure = null;\n\nconst adults = null;\n\nconst childrenAges = [];\n\nconst channelCode = null;\nconst ratePlanCode = null;\nconst ratePlanName = null;\nconst ratePlanId = null;\n\n// --------------------\n// Debug / trace context\n// --------------------\nconst sourceComments = `\nBooker Comment: ${bookerComment}\nExtra Booking Comment: ${extraBookingComment}\n`.trim();\n\n// --------------------\n// Final output (single item)\n// --------------------\nreturn [\n  {\n    json: {\n      context,\n      now,\n      // Identifiers\n      propertyId: property?.id || null,\n      propertyName: property?.name || null,\n      bookingId,\n      reservationId: null,\n\n      // Booker\n      bookerFirstName,\n      bookerLastName,\n      primaryGuestFirstName,\n      primaryGuestLastName,\n      primaryGuestBirthday,\n\n      // Comments\n      bookerComment,\n      extraBookingComment,\n      reservationComment,\n      guestComment,\n\n      // Unit\n      unitId: unit?.id || null,\n      unitName: unit?.name || null,\n      unitDescription: unit?.description || null,\n      unitGroupIdFromUnit: unit?.unitGroupId || null,\n\n      // Unit group\n      unitGroupId: unitGroup?.id || null,\n      unitGroupCode: unitGroup?.code || null,\n      unitGroupName: unitGroup?.name || null,\n      unitGroupType: unitGroup?.type || null,\n\n      // Stay details\n      arrival,\n      departure,\n      adults,\n      childrenAges,\n      channelCode,\n      ratePlanCode,\n      ratePlanName,\n      ratePlanId,\n\n      // Trace/debug\n      sourceComments,\n    },\n  },\n];\n"
      },
